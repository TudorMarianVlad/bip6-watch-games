{
  "configVersion": "v3",
  "app": {
    "appId": 21384,
    "appName": "Wristlings",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "zepp",
    "description": "Catch, feed and battle creatures powered by your steps and sleep"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage",
    "data:user.hd.step",
    "data:user.hd.heart_rate",
    "data:user.hd.sleep",
    "data:user.hd.calorie",
    "data:user.hd.pai",
    "data:os.weather.weather"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "4.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/index"
          ]
        },
        "secondary-widget": {
          "widgets": [
            {
              "path": "secondary-widget/index",
              "icon": "icon.png",
              "preview": "widget-preview.png",
              "name": "Wristlings",
              "runtime": {
                "type": "js"
              }
            }
          ]
        }
      },
      "platforms": [
        {
          "st": "s",
          "dw": 390
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Wristlings"
    }
  },
  "defaultLanguage": "en-US"
}
